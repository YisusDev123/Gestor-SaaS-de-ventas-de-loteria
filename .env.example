NODE_ENV=development
PORT=2000
APP_RELEASE=local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=portfolio_app
MYSQL_PASSWORD=replace_with_a_local_password
MYSQL_DB=portfolio_sales_saas
MYSQL_SSL_CA=
MYSQL_CONNECTION_LIMIT=20
MYSQL_QUEUE_LIMIT=50
MYSQL_ACQUIRE_TIMEOUT_MS=10000
MYSQL_QUERY_TIMEOUT_MS=8000
MYSQL_LOCK_WAIT_TIMEOUT_SECONDS=5
JWT_SECRET=replace_with_at_least_32_random_bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
REFRESH_COOKIE_NAME=portfolio_sales_refresh
ADMIN_REFRESH_COOKIE_NAME=portfolio_sales_admin_refresh
PASSWORD_RESET_PROVIDER=disabled
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false
REQUIRE_HTTPS=false
PROCESS_ROLE=all
OBSERVABILITY_TOKEN=replace_with_at_least_32_random_bytes
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
ALLOW_DB_MIGRATION=false
ALLOW_DB_TEST_BOOTSTRAP=false
SAAS_TEST_CREDENTIALS_FILE=.ci-test.env
