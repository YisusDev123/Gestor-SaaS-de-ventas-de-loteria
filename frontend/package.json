{
  "name": "multi-tenant-sales-saas-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.1 <23"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui:stage10": "node scripts/stage10-admin-smoke.js",
    "test:ui:stage10:seller": "node scripts/stage10-seller-smoke.js",
    "icons:pwa": "node scripts/generate-pwa-icons.js",
    "test:pwa": "npm run build && node scripts/test-pwa.js",
    "test:budget": "npm run build && node scripts/check-bundle-budget.js",
    "test:e2e": "npm run build && playwright test",
    "test:a11y": "npm run build && playwright test --grep @a11y",
    "test:performance": "npm run build && playwright test --grep @performance --project chromium-escritorio",
    "check": "npm run lint && npm test && npm run build && node scripts/test-pwa.js && node scripts/check-bundle-budget.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.87.4",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.2",
    "web-vitals": "^6.2.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.13",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.0"
  }
}
